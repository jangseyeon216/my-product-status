<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>관리 탭 (마이)</title>

<link rel="preconnect" href="https://cdn.jsdelivr.net">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">

<style>
  *, *::before, *::after {
    box-sizing: border-box; margin: 0; padding: 0;
    font-family: 'Pretendard Variable', Pretendard, -apple-system, sans-serif;
    -webkit-font-smoothing: antialiased;
    -webkit-tap-highlight-color: transparent;
  }

  /* ── 컨트롤 바 ── */
  #controls .preset {
    padding: 4px 10px; border-radius: 6px;
    border: 1px solid #d1d5db; background: #f9fafb;
    font-size: 12px; font-weight: 500; color: #374151;
    cursor: pointer; transition: background .15s, border-color .15s; white-space: nowrap;
  }
  #controls .preset:hover  { background: #ede9fe; border-color: #8b5cf6; color: #5940df; }
  #controls .preset.active { background: #ede9fe; border-color: #5940df; color: #5940df; }
  #controls .ctrl-div { width: 1px; height: 20px; background: #e5e7eb; }
  #controls input[type=number] {
    width: 52px; padding: 3px 6px; border: 1px solid #d1d5db; border-radius: 6px;
    font-size: 13px; font-weight: 500; text-align: center; color: #374151; background: #f9fafb; outline: none;
  }
  #controls input[type=number]:focus { border-color: #5940df; }
  #controls input[type=number]::-webkit-inner-spin-button,
  #controls input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; }
  #controls label { color: #6b7280; font-size: 12px; }
  #apply-btn {
    padding: 4px 12px; border-radius: 6px; border: none;
    background: #5940df; color: #fff; font-size: 12px; font-weight: 600;
    cursor: pointer; transition: opacity .15s;
  }
  #apply-btn:hover { opacity: .85; }

  /* ── 반응형 ── */
  @media (max-width: 767px) {
    body { background: #dadfed; }
    #controls { display: none !important; }
    #frame {
      width: 100vw !important;
      height: 100dvh !important;
      border-radius: 0 !important;
    }
  }
  @media (min-width: 768px) {
    body {
      padding: 24px 0 48px; background: #c0c5d4;
      display: flex; flex-direction: column; align-items: center; gap: 16px; min-height: 100vh;
    }
    #controls {
      display: flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: center;
      background: rgba(255,255,255,.9); backdrop-filter: blur(8px);
      border: 1px solid rgba(0,0,0,.1); border-radius: 12px; padding: 8px 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,.1);
    }
    #frame { flex-shrink: 0; box-shadow: 0 24px 48px rgba(0,0,0,.25), 0 8px 16px rgba(0,0,0,.12); }
  }

  /* ── 프레임 ── */
  #frame {
    position: relative; overflow: hidden;
    margin: 0 auto; background: #dadfed;
  }
  #ut-stage { position: relative; width: 100%; height: 100%; overflow: hidden; }

  /* ─────────────────────────────────────
     마이 화면 스타일
  ───────────────────────────────────── */

  /* Rule 1: 스크롤 컨테이너 */
  #scroll-area {
    position: absolute; inset: 0;
    overflow-y: auto; z-index: 10;
    padding: 80px 19px 140px;
    display: flex; flex-direction: column; gap: 7px;
  }
  #scroll-area::-webkit-scrollbar { display: none; }

  /* Rule 2: 헤더 고정 */
  #my-header {
    position: absolute; top: 0; left: 0; right: 0; z-index: 50;
    display: flex; align-items: center; justify-content: space-between;
    padding: 11px 19px;
  }
  .hbtn {
    width: 46px; height: 46px; border-radius: 999px; flex-shrink: 0;
    background: rgba(255,255,255,.4); border: none;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; padding: 0; outline: none;
    box-shadow: 0 0 16px rgba(0,0,0,.05);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  }

  /* 카드 공통 */
  .card {
    background: rgba(255,255,255,.9); border-radius: 27px;
    padding: 22px 27px;
    display: flex; align-items: center; justify-content: space-between;
    flex-shrink: 0;
  }
  .card-left { display: flex; flex-direction: column; gap: 4px; flex: 1; min-width: 0; }
  .val-row { display: flex; gap: 4px; align-items: flex-start; flex-wrap: wrap; }
  .val {
    font-size: 17px; font-weight: 600; color: #101010;
    letter-spacing: -0.52px; line-height: 1.3; white-space: nowrap;
  }
  .badge {
    background: #f4f5fa; border-radius: 6px; padding: 4px 6px;
    font-size: 10.5px; font-weight: 500; color: rgba(16,16,16,.5);
    letter-spacing: -0.42px; white-space: nowrap; flex-shrink: 0;
  }
  .sub {
    font-size: 11.5px; font-weight: 500; color: rgba(16,16,16,.6);
    letter-spacing: -0.46px; white-space: nowrap; line-height: 1.3;
  }
  .ico-wrap {
    width: 38px; height: 38px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
  }

  /* 프로필 카드 */
  #profile-card {
    background: rgba(255,255,255,.9); border-radius: 27px; overflow: hidden; flex-shrink: 0;
  }
  .profile-inner {
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px 27px; height: 76px;
  }
  .profile-info { display: flex; gap: 6px; align-items: center; }
  .avatar {
    width: 23px; height: 23px; border-radius: 50%;
    background: #7b8ff5; display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; overflow: hidden;
  }
  .avatar span { font-size: 10px; font-weight: 700; color: #fff; }
  .name-txt { font-size: 15px; font-weight: 600; color: #101010; letter-spacing: -0.6px; white-space: nowrap; }
  .phone-txt { font-size: 11.5px; font-weight: 500; color: rgba(16,16,16,.6); letter-spacing: -0.46px; white-space: nowrap; }
  .change-btn {
    background: #ebeef6; border-radius: 9999px; padding: 6px 12px;
    font-size: 11.5px; font-weight: 700; color: rgba(5,0,26,.5);
    letter-spacing: -0.58px; white-space: nowrap; flex-shrink: 0;
  }

  /* 바코드 카드 */
  #barcode-card {
    background: rgba(255,255,255,.9); border-radius: 27px;
    padding: 24px 27px; height: 156px;
    display: flex; flex-direction: column; gap: 10px; flex-shrink: 0;
  }
  .barcode-meta { display: flex; align-items: center; justify-content: space-between; }
  .barcode-nums { display: flex; gap: 8px; font-size: 10.5px; font-weight: 500; color: rgba(16,16,16,.5); letter-spacing: -0.42px; }
  .barcode-time { font-size: 10.5px; font-weight: 500; color: #3e4dc0; letter-spacing: -0.42px; }

  /* 자주 보는 메뉴 */
  #menu-card {
    background: rgba(255,255,255,.9); border-radius: 27px;
    padding: 22px 27px; flex-shrink: 0;
  }
  .menu-title { font-size: 17px; font-weight: 500; color: #101010; letter-spacing: -0.52px; margin-bottom: 22px; line-height: 1.3; }
  .menu-item { padding: 8px 0; font-size: 13.5px; font-weight: 500; color: #101010; letter-spacing: -0.54px; line-height: 1.2; }
  .menu-item + .menu-item { border-top: none; }

  /* Rule 3: 그라데이션 페이드 */
  #bottom-fade {
    position: absolute; bottom: 0; left: 0; right: 0; height: 134px;
    background: linear-gradient(to bottom, rgba(218,223,237,0) 0%, #dadfed 50%);
    z-index: 40; pointer-events: none;
  }

  /* Rule 3: GNB 고정 */
  #gnb {
    position: absolute; bottom: 16px; left: 0; right: 0;
    z-index: 50; height: 57px;
  }
  #gnb-home {
    position: absolute; left: 19px; top: 4px;
    width: 50px; height: 50px; border-radius: 25px;
    background: rgba(255,255,255,.5);
    box-shadow: 0 0 19px rgba(0,0,0,.05);
    overflow: hidden;
  }
  /* ico/gnb/t-home 래퍼 (22.9px) — Figma: left:13.36, top:13.36 in 49.6px button */
  #gnb-thome-wrap {
    position: absolute; left: 13px; top: 13px;
    width: 23px; height: 23px;
  }
  /* T 아이콘 (17.2px) — Figma: left≈2px, top:2.86px in wrapper */
  #gnb-home-ico {
    position: absolute; left: 2px; top: 3px;
    width: 17px; height: 17px;
  }
  /* 별 배지 (5.4px) — Figma: left:14.31px, top:13.36px in wrapper */
  #gnb-home-star {
    position: absolute; left: 14px; top: 13px;
    width: 6px; height: 6px;
  }
  #gnb-pill {
    position: absolute; left: 76px; top: 0;
    width: calc(100% - 96px); height: 57px;
    background: rgba(255,255,255,.5); border-radius: 999px;
    box-shadow: 0 0 19px rgba(0,0,0,.05);
    overflow: hidden;
  }
  /* 마이 활성 배경 */
  #gnb-active-bg {
    position: absolute;
    right: 4px; top: 4px;
    width: calc(33.333% - 4px); height: calc(100% - 8px);
    background: rgba(226,230,241,.8); border-radius: 48px;
  }
  .gnb-tab {
    position: absolute; top: 0; height: 100%;
    width: 33.333%;
    display: flex; flex-direction: column; align-items: center;
    justify-content: center; gap: 2px;
  }
  .gnb-tab:nth-child(2) { left: 0; }
  .gnb-tab:nth-child(3) { left: 33.333%; }
  .gnb-tab:nth-child(4) { left: 66.666%; }
  .gnb-tab-lbl {
    font-size: 11.5px; font-weight: 500; letter-spacing: -0.12px; line-height: 1.3;
    color: rgba(16,16,16,.3);
  }
  .gnb-tab.active .gnb-tab-lbl { color: #3617ce; }

  /* 홈 인디케이터 */
  #home-indicator {
    position: absolute; bottom: 8px; left: 50%; transform: translateX(-50%);
    width: 128px; height: 5px; background: #101010; border-radius: 100px; z-index: 60;
  }
</style>
</head>
<body>

<!-- ── 컨트롤 바 ── -->
<div id="controls">
  <span>화면 크기</span>
  <button class="preset active" data-w="375" data-h="812">iPhone 14</button>
  <button class="preset" data-w="390" data-h="844">iPhone 14 Pro</button>
  <button class="preset" data-w="393" data-h="852">iPhone 16 Pro</button>
  <div class="ctrl-div"></div>
  <label>W <input type="number" id="inp-w" value="375" min="320" max="430"></label>
  <label>H <input type="number" id="inp-h" value="812" min="667" max="932"></label>
  <button id="apply-btn">적용</button>
</div>

<!-- ── 폰 프레임 ── -->
<div id="frame" style="width:375px; height:812px; border-radius:44px;">
<div id="ut-stage">

<!-- ══════════════════════════════════════════
     마이 화면 (관리 탭 Full)
     Figma 9411-19746
══════════════════════════════════════════ -->
<div style="position:relative; width:100%; height:100%; overflow:hidden; background:#dadfed;">

  <!-- 배경 이미지 -->
  <img src="assets/img-bg.png" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center top; z-index:1; pointer-events:none;" alt="">

  <!-- ════════════════════════════════════
       Rule 1: 스크롤 컨테이너
  ════════════════════════════════════ -->
  <div id="scroll-area">

    <!-- 프로필 -->
    <div id="profile-card">
      <div class="profile-inner">
        <div class="profile-info">
          <img class="avatar" src="assets/img-profile.png" width="23" height="23" style="object-fit:cover;" alt="프로필">
          <span class="name-txt">박지훈님</span>
          <span class="phone-txt">010-1234-5678</span>
        </div>
        <div class="change-btn">회선 변경</div>
      </div>
    </div>

    <!-- 실시간 이용요금 -->
    <div class="card">
      <div class="card-left">
        <div class="val-row">
          <span class="val">39,250원</span>
          <span class="badge">3월 납부완료</span>
        </div>
        <span class="sub">실시간 이용요금</span>
      </div>
      <div class="ico-wrap">
        <img src="assets/ico-bill.png" width="38" height="38" alt="">
      </div>
    </div>

    <!-- T멤버십 포인트 -->
    <div class="card">
      <div class="card-left">
        <div class="val-row">
          <span class="val">13,500P</span>
          <span class="badge">3월 누적할인 1,700원</span>
        </div>
        <span class="sub">T멤버십 포인트</span>
      </div>
      <div class="ico-wrap">
        <img src="assets/ico-point.png" width="38" height="38" alt="">
      </div>
    </div>

    <!-- T멤버십 바코드 -->
    <div id="barcode-card">
      <span class="sub">T멤버십</span>
      <div>
        <img src="assets/img-barcode.png" style="width:100%; height:46px; object-fit:cover; border-radius:2px; display:block;" alt="바코드">
        <div class="barcode-meta" style="margin-top:8px;">
          <div class="barcode-nums">
            <span>1234</span><span>4561</span><span>1506</span><span>4932</span>
          </div>
          <span class="barcode-time">19:58</span>
        </div>
      </div>
    </div>

    <!-- 실시간 잔여량 -->
    <div class="card">
      <div class="card-left">
        <div class="val-row">
          <span class="val">6.5GB</span>
          <span class="badge">20GB 제공</span>
        </div>
        <span class="sub">실시간 잔여량</span>
      </div>
      <div class="ico-wrap">
        <img src="assets/ico-data.png" width="38" height="38" alt="">
      </div>
    </div>

    <!-- 결합가족 -->
    <div class="card">
      <div class="card-left">
        <div class="val-row">
          <span class="val">4명 결합</span>
          <span class="badge">15,000원 할인</span>
        </div>
        <span class="sub">결합가족</span>
      </div>
      <div class="ico-wrap">
        <img src="assets/ico-family.png" width="38" height="38" alt="">
      </div>
    </div>


    <!-- 휴대폰 결제 -->
    <div class="card">
      <div class="card-left">
        <div class="val-row">
          <span class="val">23,800원</span>
          <span class="badge">80,000원 한도</span>
        </div>
        <span class="sub">휴대폰 결제 / 콘텐츠 이용료</span>
      </div>
      <div class="ico-wrap">
        <img src="assets/ico-phone.png" width="38" height="38" alt="">
      </div>
    </div>

    <!-- 자주 보는 메뉴 -->
    <div id="menu-card">
      <div class="menu-title">자주 보는 메뉴</div>
      <div class="menu-item">데이터/통화 관리</div>
      <div class="menu-item">나의 요금제/부가서비스</div>
      <div class="menu-item">약정할인/기기 할부 정보</div>
      <div class="menu-item">나의 PASS지갑</div>
      <div class="menu-item">나의 쇼핑</div>
    </div>

  </div><!-- /scroll-area -->

  <!-- ════════════════════════════════════
       Rule 2: 상단 헤더 고정
  ════════════════════════════════════ -->
  <div id="my-header">
    <div style="width:46px;"></div>
    <div style="display:flex; gap:6px; align-items:center;">

      <button class="hbtn" aria-label="바코드">
        <img src="assets/ico-header-barcode.svg" width="24" height="24" alt="">
      </button>
      <button class="hbtn" aria-label="장바구니">
        <img src="assets/ico-header-cart.svg" width="24" height="24" alt="">
      </button>
      <button class="hbtn" aria-label="메뉴">
        <img src="assets/ico-header-menu.svg" width="24" height="24" alt="">
      </button>

    </div>
  </div>

  <!-- ════════════════════════════════════
       Rule 3: 그라데이션 페이드 (스크롤 밖)
  ════════════════════════════════════ -->
  <div id="bottom-fade"></div>

  <!-- ════════════════════════════════════
       Rule 3: GNB 고정
  ════════════════════════════════════ -->
  <div id="gnb">
    <!-- T홈 버튼 -->
    <div id="gnb-home">
      <div id="gnb-thome-wrap">
        <img id="gnb-home-ico" src="assets/ico-thome-main.svg" alt="T홈">
        <img id="gnb-home-star" src="assets/ico-thome-star2.svg" alt="">
      </div>
    </div>
    <!-- 네비 pill -->
    <div id="gnb-pill">
      <div id="gnb-active-bg"></div>
      <!-- 혜택 -->
      <div class="gnb-tab">
        <img src="assets/ico-gnb-benefits2.svg" width="23" height="23" alt="">
        <span class="gnb-tab-lbl">혜택</span>
      </div>
      <!-- 쇼핑 -->
      <div class="gnb-tab">
        <img src="assets/ico-gnb-shopping2.svg" width="23" height="23" alt="">
        <span class="gnb-tab-lbl">쇼핑</span>
      </div>
      <!-- 마이 (활성) -->
      <div class="gnb-tab active">
        <img src="assets/ico-gnb-my2.svg" width="23" height="23" alt="">
        <span class="gnb-tab-lbl">마이</span>
      </div>
    </div>
  </div>

  <!-- 홈 인디케이터 -->
  <div id="home-indicator"></div>

</div><!-- /화면 wrapper -->
</div><!-- /ut-stage -->
</div><!-- /frame -->

<script>
  /* ── 컨트롤 바 ── */
  document.querySelectorAll('#controls .preset').forEach(btn => {
    btn.addEventListener('click', () => {
      const w = +btn.dataset.w, h = +btn.dataset.h;
      applySize(w, h);
      document.getElementById('inp-w').value = w;
      document.getElementById('inp-h').value = h;
      document.querySelectorAll('#controls .preset').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    });
  });
  document.getElementById('apply-btn').addEventListener('click', () => {
    applySize(+document.getElementById('inp-w').value, +document.getElementById('inp-h').value);
    document.querySelectorAll('#controls .preset').forEach(b => b.classList.remove('active'));
  });
  function applySize(w, h) {
    const frame = document.getElementById('frame');
    frame.style.width  = w + 'px';
    frame.style.height = h + 'px';
  }
</script>
</body>
</html>
